                    },
                    "S7NVE": {
                      "content": "CASE 03 · MAPA HDS · desde 2021"
                    },
                    "JKvNV": {
                      "content": "Workflow de pré-vendas"
                    },
                    "iqUia": {
                      "content": "Não havia pré-vendas: dois closers prospectavam por conta própria, via networking e LinkedIn."
                    },
                    "et28B": {
                      "content": "Sem pipeline, sem ICP e sem métricas, os leads chegavam de forma imprevisível e com pouca informação."
                    },
                    "T06aZh": {
                      "content": "Defini o papel de cada área no processo comercial"
                    },
                    "HH8oy": {
                      "content": "Estruturei critérios de qualificação, etapas de funil e o fluxo de inbound"
                    },
                    "i3tM6": {
                      "content": "Desenhei e testei o outbound, com ICP definido junto à direção"
                    },
                    "cHVAc": {
                      "content": "2"
                    },
                    "V7hYmL": {
                      "content": "fechamentos outbound já no primeiro mês"
                    }
                  }
                },
