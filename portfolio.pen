                    "JKvNV": {
                      "content": "Método PRISMA com low-code"
                    },
                    "iqUia": {
                      "content": "Conduzindo formações em pesquisa, vi as mesmas dificuldades se repetirem na revisão sistemática com o método PRISMA."
                    },
                    "et28B": {
                      "content": "O processo era manual, com controle de versões frágil e nenhuma ferramenta prática para organizar as etapas."
                    },
                    "T06aZh": {
                      "content": "Prototipei um sistema no Base44 (low-code)"
                    },
                    "HH8oy": {
                      "content": "Testei em aula com usuários reais e ajustei a cada rodada"
                    },
                    "i3tM6": {
                      "content": "Planejei uma camada de IA para triagem e classificação de estudos"
